{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.schema.json",
  "title": "Agent action (env.step input)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args"
      ],
      "properties": {
        "tool": {
          "const": "list_records"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table"
          ],
          "properties": {
            "table": {
              "enum": [
                "ledger",
                "invoices",
                "payments",
                "fx"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args"
      ],
      "properties": {
        "tool": {
          "const": "get_record"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "table",
            "id"
          ],
          "properties": {
            "table": {
              "enum": [
                "ledger",
                "invoices",
                "payments",
                "fx"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args"
      ],
      "properties": {
        "tool": {
          "const": "get_document"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "doc_id"
          ],
          "properties": {
            "doc_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args"
      ],
      "properties": {
        "tool": {
          "const": "calculator"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expression"
          ],
          "properties": {
            "expression": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[0-9+\\-*/(). ]+$"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "args"
      ],
      "properties": {
        "tool": {
          "const": "submit"
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findings"
          ],
          "properties": {
            "findings": {
              "$ref": "findings.schema.json"
            }
          }
        }
      }
    }
  ]
}
