{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trajectory_step.schema.json",
  "title": "One line of trajectories.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "policy",
    "step",
    "action",
    "observation",
    "reward",
    "terminated",
    "truncated"
  ],
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "action": {},
    "observation": {
      "$ref": "observation.schema.json"
    },
    "reward": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
